#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ -f "$SCRIPT_DIR/versions.env" ]] && { set -a; source "$SCRIPT_DIR/versions.env"; set +a; }

# bitbake refuses to run as root. Under sudo (e.g. user not in the docker
# group), run the container as the invoking user, not uid 0.
RUN_UID="$(id -u)"
RUN_GID="$(id -g)"
USER_HOME="$HOME"
if [[ $RUN_UID -eq 0 ]]; then
  if [[ -n "${SUDO_UID:-}" && "${SUDO_UID}" -ne 0 ]]; then
    RUN_UID="$SUDO_UID"
    RUN_GID="${SUDO_GID:-$SUDO_UID}"
    USER_HOME="$(getent passwd "$SUDO_UID" | cut -d: -f6)"
  else
    echo "Error: refusing to run as root (bitbake does not allow it)." >&2
    echo "Run as a normal user; add it to the 'docker' group if needed." >&2
    exit 1
  fi
fi

IMAGE="${YOCTO_IMAGE:-ghcr.io/rajasjoshi/yocto-builder}"
VERSION="${YOCTO_UBUNTU:-${DEFAULT_UBUNTU:-22.04}}"
WORKDIR="${YOCTO_WORKDIR:-$PWD}"
CACHE="${YOCTO_CACHE:-$USER_HOME/.yocto-cache}"
PULL=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [-u VERSION] [-w DIR] [-c DIR] [-p]

  -u VERSION   Ubuntu version (default: $VERSION)
  -w DIR       Work directory mounted at /workdir (default: cwd)
  -c DIR       Cache dir for downloads/sstate (default: \$HOME/.yocto-cache)
  -p           Pull latest image before running
  -h           Show this help

Env overrides: YOCTO_IMAGE, YOCTO_UBUNTU, YOCTO_WORKDIR, YOCTO_CACHE

SSH: if \$HOME/.ssh exists it is mounted read-only at /home/yocto/.ssh
(gives the container your keys, known_hosts, and config). If an ssh-agent
is running (\$SSH_AUTH_SOCK set), it is forwarded too — needed for
passphrase-protected keys used by non-interactive bitbake fetches. Under
sudo, run with --preserve-env=SSH_AUTH_SOCK to keep the agent.

Git: your global user.name/user.email are passed in for commits.

Proxy vars (http_proxy, https_proxy, no_proxy, ftp_proxy) are forwarded
automatically when set.

Examples:
  $(basename "$0") -u 24.04
  $(basename "$0") -w ~/projects/bsp -u 20.04
EOF
}

while getopts ":u:w:c:ph" opt; do
  case "$opt" in
    u) VERSION="$OPTARG" ;;
    w) WORKDIR="$OPTARG" ;;
    c) CACHE="$OPTARG" ;;
    p) PULL=1 ;;
    h) usage; exit 0 ;;
    :) echo "Error: -$OPTARG requires an argument" >&2; exit 1 ;;
    \?) echo "Error: unknown option -$OPTARG" >&2; usage >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -eq 0 ]] || { echo "Error: unexpected argument: $1" >&2; usage >&2; exit 1; }

command -v docker >/dev/null || { echo "Error: docker not found" >&2; exit 1; }
[[ -d "$WORKDIR" ]] || { echo "Error: work dir not found: $WORKDIR" >&2; exit 1; }
WORKDIR="$(cd "$WORKDIR" && pwd)"

mkdir -p "$CACHE/downloads" "$CACHE/sstate"
CACHE="$(cd "$CACHE" && pwd)"
# Dirs created under sudo are root-owned; hand them to the container user.
[[ $(id -u) -eq 0 ]] && chown "$RUN_UID:$RUN_GID" "$CACHE" "$CACHE/downloads" "$CACHE/sstate"

TAG="$IMAGE:ubuntu-$VERSION"
[[ $PULL -eq 1 ]] && docker pull "$TAG"

PROXY_ARGS=()
for v in http_proxy https_proxy ftp_proxy no_proxy \
         HTTP_PROXY HTTPS_PROXY FTP_PROXY NO_PROXY; do
  [[ -n "${!v:-}" ]] && PROXY_ARGS+=(-e "$v=${!v}")
done

SSH_ARGS=()
if [[ -d "$USER_HOME/.ssh" ]]; then
  SSH_ARGS+=(-v "$USER_HOME/.ssh:/home/yocto/.ssh:ro")
fi
if [[ -n "${SSH_AUTH_SOCK:-}" && -S "${SSH_AUTH_SOCK}" ]]; then
  SSH_ARGS+=(-v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
elif [[ -n "${SUDO_UID:-}" ]]; then
  echo "Warning: sudo dropped SSH_AUTH_SOCK; ssh-agent not forwarded." >&2
  echo "  Use: sudo --preserve-env=SSH_AUTH_SOCK $0 ..." >&2
fi

# Commit as the host user instead of the image's fallback "kas" identity.
GIT_ARGS=()
if command -v git >/dev/null; then
  GIT_NAME="$(HOME="$USER_HOME" git config --global user.name 2>/dev/null || true)"
  GIT_EMAIL="$(HOME="$USER_HOME" git config --global user.email 2>/dev/null || true)"
  [[ -n "$GIT_NAME" ]] && GIT_ARGS+=(-e "GIT_AUTHOR_NAME=$GIT_NAME" -e "GIT_COMMITTER_NAME=$GIT_NAME")
  [[ -n "$GIT_EMAIL" ]] && GIT_ARGS+=(-e "GIT_AUTHOR_EMAIL=$GIT_EMAIL" -e "GIT_COMMITTER_EMAIL=$GIT_EMAIL")
fi

TTY_ARGS=()
[[ -t 0 && -t 1 ]] && TTY_ARGS+=(-it)

# Vars bitbake keeps from the environment. Don't also set the pre-kirkstone
# name BB_ENV_EXTRAWHITE: kirkstone+ bitbake errors out if it is set.
BB_PASSTHROUGH="DL_DIR SSTATE_DIR http_proxy https_proxy ftp_proxy no_proxy"

# Start as root so the entrypoint can remap 'yocto' to RUN_UID:RUN_GID; it
# drops privileges before starting the shell.
# --init: tini as PID 1 forwards signals and reaps orphans from bitbake.
exec docker run --rm --init "${TTY_ARGS[@]}" \
  -u 0:0 \
  -e YOCTO_UID="$RUN_UID" \
  -e YOCTO_GID="$RUN_GID" \
  -v "$WORKDIR:/workdir" \
  -v "$CACHE/downloads:/downloads" \
  -v "$CACHE/sstate:/sstate" \
  -e DL_DIR=/downloads \
  -e SSTATE_DIR=/sstate \
  -e BB_ENV_PASSTHROUGH_ADDITIONS="$BB_PASSTHROUGH" \
  "${PROXY_ARGS[@]}" \
  "${SSH_ARGS[@]}" \
  "${GIT_ARGS[@]}" \
  -w /workdir \
  "$TAG"